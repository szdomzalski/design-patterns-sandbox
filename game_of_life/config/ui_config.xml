<?xml version="1.0" encoding="UTF-8"?>
<application>
  <simulation cells_x="40" cells_y="30" alive_probability="0.2"
              random_seed="42" updates_per_second="10" ruleset="classic" />
  <window width="800" height="800" />
  <grid width="800" height="600" />
  <buttons>
    <button label="Stop" width="200" height="50" x="180" y="640" event="UI_STOP" />
    <button label="Start" width="200" height="50" x="420" y="640" event="UI_START" />
  </buttons>
  <sliders>
    <slider x="150" y="740" width="500" height="20"
            min_value="1.0" max_value="50.0" event="SPEED_CHANGE" />
  </sliders>
</application>